# Copy this file to one of these paths and edit values:
# 1) scripts/acc-gen/codex-auto.env
# 2) /web/ai-tools.su/gpt-api/acc-gen/codex-auto.env
# 3) /web/ai-tools.su/gpt-api/cliproxyapi-src/.codex-auto.env
#
# Then run short commands like:
#   bash scripts/acc-gen/codex-auto.sh --all
#   bash scripts/acc-gen/codex-auto.sh --index 6

# Core sources
CODEX_ACCOUNTS_FILE=/web/ai-tools.su/gpt-api/acc-gen/firstmail-1000-26.04.05.txt
CODEX_PROXY_FILE=/web/ai-tools.su/gpt-api/acc-gen/proxy.txt
CODEX_NAMES_FILE=/web/ai-tools.su/gpt-api/acc-gen/qwen-safe-names.txt

# Runtime outputs
CODEX_STATE_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex-auto-state.json
CODEX_USED_ACCOUNTS_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex-used-accounts.log
CODEX_PROXY_COOLDOWN_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex-proxy-cooldown.json

# Auth behavior
CODEX_AUTO_SIGNUP_ON_LOGIN_FAIL=1
CODEX_POST_CALLBACK_WAIT_SECONDS=125
CODEX_BROWSER_ENGINE=auto
CODEX_SCREENSHOTS=off

# Proxy behavior
CODEX_PROXY_SCHEME=socks5
CODEX_MAX_PROXY_ATTEMPTS=1
CODEX_PROXY_PHONE_COOLDOWN_FIRST_SEC=300
CODEX_PROXY_PHONE_COOLDOWN_SECOND_SEC=600

# Hero-SMS
HERO_SMS_API_KEY=PUT_YOUR_KEY_HERE
HERO_SMS_COUNTRIES=52,151,15,46,32
HERO_SMS_PRICE_RANKING=off
HERO_SMS_POLL_TIMEOUT_SEC=30
HERO_SMS_POLL_INTERVAL_MS=3000
HERO_SMS_MAX_COUNTRY_ATTEMPTS=5
HERO_SMS_CANCEL_RETRY_DELAY_SEC=180
# Optional service filters
# HERO_SMS_SERVICES=dr
# HERO_SMS_SERVICE_PREFIX=
# HERO_SMS_SERVICE_QUERY=open
