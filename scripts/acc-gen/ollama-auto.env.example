# Ollama Auto Authorization - Environment Configuration
# Copy this file to ollama-auto.env and fill in your values

# =============================================================================
# Hero-SMS Configuration (for phone verification)
# =============================================================================

# Hero-SMS API Key (required)
# Get from https://hero-sms.com/profile/api_keys
HERO_SMS_API_KEY=your_hero_sms_api_key_here

# Hero-SMS API Base URL
HERO_SMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php

# SMS Service Code
# "dr" = другие/other (default for Ollama)
# Other options: "go" = Google, "wh" = WhatsApp, etc.
HERO_SMS_SERVICE=dr

# SMS Countries (comma-separated country codes)
# 44 = United Kingdom (recommended for Ollama, cheapest ~4-5 cents)
# 151 = Anguilla, 15 = Bahamas, 46 = Sweden, 32 = Belgium
HERO_SMS_COUNTRIES=44

# SMS Polling Configuration
# How long to wait for SMS code (in seconds)
# Ollama SMS can take up to 5 minutes
HERO_SMS_POLL_TIMEOUT_SEC=300

# How often to poll for SMS code (in milliseconds)
HERO_SMS_POLL_INTERVAL_MS=3000

# Maximum country attempts before giving up
HERO_SMS_MAX_COUNTRY_ATTEMPTS=5

# =============================================================================
# Browser Configuration
# =============================================================================

# Browser backend: local | browserapi
# local     -> puppeteer in current environment
# browserapi-> remote SeleniumBase UC endpoint (browser.ai-tools.su)
OLLAMA_BROWSER_BACKEND=local

# Browser Engine: auto, puppeteer, playwright (used in local backend)
# "auto" will try puppeteer first, then playwright
OLLAMA_BROWSER_ENGINE=auto

# Remote Browser API settings (used when OLLAMA_BROWSER_BACKEND=browserapi)
BROWSER_API_URL=https://browser.ai-tools.su/api
BROWSER_API_KEY=

# Enable Screenshots for debugging
# Values: true, false, all
CODEX_SCREENSHOTS=false

# =============================================================================
# Ollama-Specific Configuration
# =============================================================================

# Email verification code override (optional)
# If empty, script will fetch latest 6-digit code via IMAP
OLLAMA_EMAIL_CODE=

# IMAP settings for automatic email code retrieval
# Usually mailbox password is the same as account password in accounts.json
OLLAMA_IMAP_HOST=imap.firstmail.ltd
OLLAMA_IMAP_PORT=993
OLLAMA_EMAIL_CODE_WAIT_SEC=90

# Allow manual solving of anti-bot human check (requires interactive terminal)
OLLAMA_ALLOW_MANUAL_HUMAN_CHECK=false

# Timeout for email input page (milliseconds)
OLLAMA_EMAIL_INPUT_TIMEOUT_MS=10000

# Timeout for password input page (milliseconds)
OLLAMA_PASSWORD_INPUT_TIMEOUT_MS=10000

# Timeout for email code verification page (milliseconds)
OLLAMA_EMAIL_CODE_TIMEOUT_MS=15000

# Timeout for phone input page (milliseconds)
OLLAMA_PHONE_INPUT_TIMEOUT_MS=15000

# Timeout for SMS code verification page (milliseconds)
OLLAMA_SMS_CODE_TIMEOUT_MS=30000

# Timeout for API key page (milliseconds)
OLLAMA_API_KEY_PAGE_TIMEOUT_MS=15000

# Navigation timeout (milliseconds)
OLLAMA_NAVIGATION_TIMEOUT_MS=30000

# =============================================================================
# Accounts Configuration
# =============================================================================

# Path to accounts file (JSON format)
OLLAMA_ACCOUNTS_FILE=./ollama-accounts.json

# Path to state file (for batch processing resume)
OLLAMA_STATE_FILE=./ollama-auto-state.json

# Path to used accounts file
OLLAMA_USED_FILE=./ollama-used.txt

# Optional: router config file to auto-insert generated API key
# Example runtime path: /web/ai-tools.su/gpt-api/config.yaml
OLLAMA_ROUTER_CONFIG_PATH=

# =============================================================================
# Proxy Configuration (optional)
# =============================================================================

# Proxy scheme: http, https, socks4, socks5
OLLAMA_PROXY_SCHEME=http

# =============================================================================
# Example Accounts File Format (ollama-accounts.json)
# =============================================================================
# [
#   {
#     "email": "user1@example.com",
#     "password": "SecurePassword123!",
#     "name": "John Doe"
#   },
#   {
#     "email": "user2@example.com",
#     "password": "AnotherPassword456!",
#     "name": "Jane Smith"
#   }
# ]
