# Codex auto batch profile
CODEX_SCREENSHOTS=on

# Sources
CODEX_ACCOUNTS_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex/new_19_accounts.json
CODEX_PROXY_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex/qwen-proxies.txt
CODEX_NAMES_FILE=/web/ai-tools.su/gpt-api/acc-gen/qwen-safe-names.txt

# Runtime files
CODEX_STATE_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex-auto-state.json
CODEX_USED_ACCOUNTS_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex-used-accounts.log
CODEX_PROXY_COOLDOWN_FILE=/web/ai-tools.su/gpt-api/acc-gen/codex-proxy-cooldown.json

# Flow
CODEX_AUTO_SIGNUP_ON_LOGIN_FAIL=1
CODEX_POST_CALLBACK_WAIT_SECONDS=5
CODEX_BROWSER_ENGINE=auto

# Proxy retries/cooldown
CODEX_PROXY_SCHEME=https
CODEX_MAX_PROXY_ATTEMPTS=1
CODEX_PROXY_PHONE_COOLDOWN_FIRST_SEC=300
CODEX_PROXY_PHONE_COOLDOWN_SECOND_SEC=600

# Hero-SMS
HERO_SMS_API_KEY=9d71df0e6A6436413Ad72d58fA8AA445
HERO_SMS_COUNTRIES=54
HERO_SMS_PRICE_RANKING=off
HERO_SMS_POLL_TIMEOUT_SEC=120
HERO_SMS_POLL_INTERVAL_MS=3000
HERO_SMS_MAX_COUNTRY_ATTEMPTS=3
HERO_SMS_CANCEL_RETRY_DELAY_SEC=5

CODEX_FORCE_SIGNUP=0
CODEX_CALLBACK_PORT=1455

# Timeouts for Cloudflare
CODEX_AUTH_PAGE_NAV_TIMEOUT_MS=60000
CODEX_AUTH_PAGE_NAV_RETRIES=3
CODEX_EMAIL_INPUT_TIMEOUT_MS=30000
CODEX_BLANK_PAGE_SETTLE_MS=8000
HERO_SMS_MAX_PRICE=0.50
